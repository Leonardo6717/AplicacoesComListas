<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/rootFilmes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC">


    <!-- CONTEÚDO DA TELA -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="100dp">


        <!-- TÍTULO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="🎬 Filmes Favoritos"

            android:textColor="#24202B"
            android:textSize="27sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp"

            android:text="Adicione os filmes que você mais gosta."

            android:textSize="14sp"
            android:textColor="#77717F" />


        <!-- CARD DE CADASTRO -->

        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">


            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="18dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Novo filme"

                    android:textStyle="bold"
                    android:textSize="18sp"

                    android:textColor="#302A38" />


                <!-- TÍTULO DO FILME -->

                <EditText
                    android:id="@+id/edtTitulo"

                    android:layout_width="match_parent"
                    android:layout_height="55dp"

                    android:layout_marginTop="15dp"

                    android:background="@drawable/bg_input"

                    android:hint="Título do filme"

                    android:singleLine="true"

                    android:textSize="15sp" />


                <!-- DIRETOR -->

                <EditText
                    android:id="@+id/edtDiretor"

                    android:layout_width="match_parent"
                    android:layout_height="55dp"

                    android:layout_marginTop="10dp"

                    android:background="@drawable/bg_input"

                    android:hint="Diretor"

                    android:singleLine="true"

                    android:textSize="15sp" />


                <!-- ADICIONAR -->

                <com.google.android.material.button.MaterialButton

                    android:id="@+id/btnAdicionarFilme"

                    android:layout_width="match_parent"
                    android:layout_height="52dp"

                    android:layout_marginTop="16dp"

                    android:text="+  Adicionar filme"

                    android:textAllCaps="false"

                    android:textStyle="bold"
                    android:textSize="15sp"

                    android:textColor="#FFFFFF"

                    android:insetTop="0dp"
                    android:insetBottom="0dp"

                    app:cornerRadius="17dp"
                    app:backgroundTint="#6C4FD3" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- TÍTULO DA LISTA -->

        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"

            android:text="Minha coleção"

            android:textStyle="bold"
            android:textSize="18sp"

            android:textColor="#302A38" />


        <!-- RECYCLERVIEW -->

        <androidx.recyclerview.widget.RecyclerView

            android:id="@+id/recyclerFilmes"

            android:layout_width="match_parent"
            android:layout_height="0dp"

            android:layout_weight="1"

            android:clipToPadding="false"

            android:paddingBottom="15dp" />


    </LinearLayout>


    <!-- BOTÃO VOLTAR -->

    <com.google.android.material.button.MaterialButton

        android:id="@+id/btnVoltarFilmes"

        android:layout_width="wrap_content"
        android:layout_height="50dp"

        android:layout_gravity="bottom|end"

        android:layout_marginEnd="35dp"
        android:layout_marginBottom="35dp"

        android:text="←  Voltar"

        android:textAllCaps="false"

        android:textSize="14sp"
        android:textStyle="bold"

        android:textColor="#FFFFFF"

        android:insetTop="0dp"
        android:insetBottom="0dp"

        android:elevation="10dp"

        app:cornerRadius="18dp"

        app:backgroundTint="#6C4FD3" />


</FrameLayout>